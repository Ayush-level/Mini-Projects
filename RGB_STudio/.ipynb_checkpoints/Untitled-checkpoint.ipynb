    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as patches\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "ax.add_patch(patches.Rectangle((1, 1), 2, 2, facecolor='skyblue', edgecolor='red', linewidth=2))\n",
    "ax.set_xlim(0, 5)\n",
    "ax.set_ylim(0, 5)\n",
    "plt.show()"
